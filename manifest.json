{
  "manifest_version": 3,
  "name": "Full Page Capture",
  "version": "1.2.0",
  "description": "Capture scrolling pages, draw and highlight, then copy or save locally.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Full Page Capture" }
}
